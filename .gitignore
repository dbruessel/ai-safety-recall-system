# --- Local Raw Data Dumps, CSVs & Big Files ---
data/
data/raw/
data/processed/
*.csv
*.zip

# --- Backend Storage Restrictions ---
# Ignore raw flat data dumps and zip files located inside scripts
backend/scripts/FLAT_RCL_*
backend/scripts/*.txt
backend/scripts/*.zip

# Catch local data files, python environments, and secret keys
backend/.venv/
backend/__pycache__/
backend/.env
.venv/
.env

# --- Python Runtime and App Cache ---
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# --- Frontend Node & Package Artifacts ---
node_modules/
frontend/node_modules/
frontend/test-results/
frontend/dist/
frontend/dist-ssr/
*.local

# Secret Keys & Credentials
*.json
serviceAccountKey.json
backend/scripts/serviceAccountKey.json
supabase/.temp/

# Log files
backend/logs/
logs/
*.log

# --- Editor directories and OS files ---
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?